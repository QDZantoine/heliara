# Stockage objet MinIO, si c'est la voie retenue.
#
# À trancher avant de s'engager : MinIO est sous licence AGPL v3, ce qui mérite une lecture
# attentive pour une société qui édite du logiciel. Un S3 managé évite entièrement la
# question. Le projet parle S3 standard, les deux conviennent.
#
# Le seau s'appelle `heliara`, et seul son préfixe `public/` est ouvert en lecture anonyme :
# c'est ce qui laisse les images du site être servies sans signature, le reste demeurant
# privé. À poser une fois le service démarré, avec le client `mc`.

[Unit]
Description=MinIO - stockage objet Heliara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minio-user
Group=minio-user
WorkingDirectory=/srv/minio

# Le compte racine ne sert qu'à créer le compte de service restreint au seul seau.
# Une fois celui-ci créé, c'est lui que l'application utilise - jamais la racine.
EnvironmentFile=/etc/heliara/minio.env

# Lié à la boucle locale : le reverse proxy publie les médias, pas MinIO directement.
ExecStart=/usr/local/bin/minio server /srv/minio/data \
  --address 127.0.0.1:9000 \
  --console-address 127.0.0.1:9001

Restart=always
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/minio
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
