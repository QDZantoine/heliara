# Le site public. Exposé à Internet derrière le reverse proxy.
#
# Il lit /etc/heliara/read.env, qui ne doit contenir QUE les identifiants de lecture :
# entièrement compromis, ce processus ne détient alors aucun moyen d'écrire en base.
# Ne pas lui donner DB_WRITE_USER ni DB_WRITE_PASSWORD.

[Unit]
Description=Heliara - site public
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=heliara
Group=heliara
WorkingDirectory=/srv/heliara

Environment=NODE_ENV=production
Environment=HELIARA_ROLE=read
Environment=PORT=3000
EnvironmentFile=/etc/heliara/read.env

ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5

# Durcissement : ce processus n'écrit que dans le cache de Next.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/heliara/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
