# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Tout répertoire de build alternatif, réglé par NEXT_DIST_DIR. `pnpm dev:both` en
# utilise deux - un par rôle, pour contourner le verrou de Next sur le serveur de dev -
# et une vérification ponctuelle peut en créer d'autres. Un motif plutôt que deux noms :
# un répertoire de build oublié se retrouve sinon versionné, et fait échouer le lint sur
# quatorze mille problèmes dans du code généré.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le modèle est versionné : il documente les variables attendues, sans valeur.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Outillage local, propre a la machine et non au projet.
# `.claude/settings.local.json` n'etait ignore que par le gitignore global de la
# machine : il aurait ete commite depuis n'importe quel autre poste.
/.serena/
/.claude/settings.local.json
/.vscode/
/.idea/

# Maquettes « Claude Design » exportees, hors du depot : 284 ko de HTML genere,
# jamais importe par le code, et lu par une personne seulement au moment de
# transcrire un ecran. Voir la section « Sources de verite » de CLAUDE.md.
/reference/

# Journaux et brouillons
*.log
