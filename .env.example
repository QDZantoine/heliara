# ============================================================
# HELIARA - variables d'environnement
# ============================================================
# Ce fichier est **versionné** et sert de référence : il liste toutes les
# variables attendues, avec une valeur d'exemple pour montrer la forme de
# chacune.
#
# **Aucune de ces valeurs n'est réelle.** Celles qui portent « à remplacer »
# doivent l'être une par une, et aucun secret ne doit jamais être écrit ici :
# le fichier part dans le dépôt, donc chez tout le monde. Les vraies valeurs
# vivent dans un `.env` local, non versionné, et dans le gestionnaire de
# secrets du déploiement.
#
# Générer un mot de passe : openssl rand -base64 24
#
# Ce que l'infrastructure doit fournir **au-delà** de ces variables est
# décrit dans docs/deploiement.md.
# ============================================================

# Envoi du formulaire de contact (app/contact/actions.ts).
# Sans RESEND_API_KEY ni CONTACT_FROM, le formulaire n'envoie rien et affiche une
# erreur explicite renvoyant vers l'adresse e-mail publique : il ne prétend
# jamais avoir envoyé.

# Clé API Resend - https://resend.com/api-keys
# Toujours de la forme `re_` suivi de 33 caractères.
RESEND_API_KEY=re_ExempleDeCleAResendAremplacer00

# Expéditeur. Doit appartenir à un domaine vérifié chez Resend, sinon l'API
# refuse l'envoi.
CONTACT_FROM=Heliara <site@exemple.test>

# Destinataire. Facultatif : à défaut, l'adresse publique de lib/site.ts.
CONTACT_TO=

# ------------------------------------------------------------
# Rôle du processus : la séparation lecture / écriture
# ------------------------------------------------------------
# Deux processus servent le même code, sur deux ports :
#
#   HELIARA_ROLE=read   port 3000, exposé publiquement. `/admin` y répond 404, et
#                       le pool d'écriture refuse de s'ouvrir.
#   HELIARA_ROLE=write  port 3001, joignable par VPN seulement. Ne sert que
#                       `/admin` ; tout le reste y répond 404.
#
# `read` est la valeur par défaut en l'absence de configuration : un oubli dégrade
# vers moins de droits, jamais vers plus.
HELIARA_ROLE=read

# ------------------------------------------------------------
# Base MariaDB (docker-compose.yml)
# ------------------------------------------------------------
# Les mots de passe ci-dessous n'existent que pour le poste de développement.
# Générer les vôtres : openssl rand -base64 24

DB_HOST=127.0.0.1
# 3307 et non 3306 : le port par défaut est souvent pris par une base locale.
DB_PORT=3307
DB_NAME=heliara

# root, db_admin et db_migrate ne servent qu'à l'initialisation et aux
# migrations. L'application ne les utilise jamais.
DB_ROOT_PASSWORD=mot-de-passe-root-a-remplacer
DB_ADMIN_PASSWORD=mot-de-passe-admin-a-remplacer
DB_MIGRATE_PASSWORD=mot-de-passe-migrate-a-remplacer

# ------------------------------------------------------------
# Les deux comptes applicatifs : la séparation lecture / écriture
# ------------------------------------------------------------
# app_read : le site public. EXECUTE sur les seules procédures `pub_*`, qui ne
# rendent que du contenu publié. Aucun droit de table, aucune écriture possible.
#
# app_write : l'administration. EXECUTE sur toutes les procédures.
#
# **Le déploiement du site public ne doit recevoir QUE les variables DB_READ_*.**
# C'est ce qui garantit qu'il ne peut pas écrire même entièrement compromis : il ne
# détient aucun identifiant qui en soit capable.
DB_READ_USER=app_read
DB_READ_PASSWORD=mot-de-passe-lecture-a-remplacer

# À ne renseigner que dans l'environnement de l'administration.
DB_WRITE_USER=app_write
DB_WRITE_PASSWORD=mot-de-passe-ecriture-a-remplacer

# ------------------------------------------------------------
# Stockage objet MinIO (docker-compose.yml)
# ------------------------------------------------------------
# **En production, cette adresse doit être publique, pas l'adresse interne du réseau
# de conteneurs.** Ce n'est pas une question de commodité : `signedUpload()` construit
# l'URL présignée de dépôt à partir de cette valeur, et c'est **le navigateur** qui
# l'utilise pour envoyer le fichier - l'application ne fait que la signer. Réglée sur une
# adresse interne du genre `http://minio:9000`, elle produit des URL que le poste de la
# personne qui téléverse ne peut pas résoudre : tout dépôt d'image échoue, alors que le
# reste de l'administration fonctionne parfaitement.
#
# Conséquence à connaître : le dépôt d'images ne marche qu'une fois le stockage joignable
# depuis Internet. Tant que son nom de domaine n'existe pas, l'administration s'ouvre, les
# textes s'enregistrent, et seules les images restent impossibles à déposer.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=heliara
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Compte racine MinIO. En production, créer un compte de service dédié restreint
# au seul seau du site plutôt que d'utiliser la racine.
S3_ROOT_USER=heliara-root
S3_ROOT_PASSWORD=mot-de-passe-minio-a-remplacer

# URL publique des médias, telle que le navigateur les demande.
#
# **En production, elle doit être joignable depuis l'extérieur, en HTTPS.** Elle porte
# plus que l'affichage des images : une réalisation ou un article qui a une image de
# tête donne **cette URL** comme carte de partage OpenGraph. Un stockage joignable
# seulement depuis le serveur donne donc des pages qui s'affichent correctement et ne
# produisent **aucun aperçu de lien** - WhatsApp, LinkedIn ou Slack ne peuvent pas
# atteindre l'image. Le symptôme est identique à celui d'un `SITE_ORIGIN` mal réglé, et
# la cause est ailleurs.
#
# En HTTP sur un site en HTTPS, c'est pire : contenu mixte, et plusieurs explorateurs
# refusent l'image sans le dire.
#
# `next.config.ts` en déduit aussi le motif `images.remotePatterns` et l'ouverture de
# `dangerouslyAllowLocalIP` : sur une adresse publique, ce garde-fou se referme tout
# seul, ce qui est le comportement voulu.
S3_PUBLIC_URL=http://127.0.0.1:9000/heliara

# ------------------------------------------------------------
# Adresse du site public, vue depuis l'administration
# ------------------------------------------------------------
# Les deux déploiements ne partagent pas d'origine : un lien relatif écrit dans
# l'administration resterait sur le port d'écriture, où tout ce qui n'est pas
# `/admin` répond 404. Les liens « Voir le site » et « Voir en ligne » ont donc
# besoin d'une URL absolue.
#
# À défaut : le port de lecture en développement, le domaine de production ailleurs.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# L'origine que ce déploiement sert, pour toutes les URL absolues : canonique,
# OpenGraph, images de partage, plan du site, robots.txt, llms.txt et données
# structurées.
#
# **À régler sur tout déploiement qui n'est pas le domaine de production** - une
# préproduction, un aperçu, un hôte d'essai. Sans elle, les balises de partage
# annoncent des URL vers heliara.fr : elles sont correctes et bien formées, elles
# pointent simplement vers un domaine qui ne sert pas cette instance, et **aucun
# aperçu de lien ne s'affiche**. Le défaut a été constaté sur WhatsApp.
#
# Sans préfixe `NEXT_PUBLIC_`, donc lue **à l'exécution** : une même image
# applicative peut servir plusieurs origines sans être reconstruite. Les pages
# étant prérendues, la valeur du build reste servie jusqu'au premier `revalidate`
# (une minute) - la régler au build aussi pour que ce soit juste dès la première
# requête.
#
# À défaut : le domaine de production. Jamais l'hôte de la requête, qu'un appelant
# pourrait dicter.
SITE_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Vérification de propriété auprès des moteurs
# ------------------------------------------------------------
# Codes fournis par Google Search Console et Bing Webmaster Tools, propres à un
# compte : ils n'ont rien à faire dans le dépôt. Absents, aucune balise n'est
# émise - c'est sans conséquence, la vérification peut aussi se faire par DNS.
GOOGLE_SITE_VERIFICATION=code-google-a-remplacer
BING_SITE_VERIFICATION=code-bing-a-remplacer
